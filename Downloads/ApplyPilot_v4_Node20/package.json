{
  "name": "applypilot-ai",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "seed": "npm run seed -w apps/api",
    "test": "npm run test -w apps/api",
    "autofill": "node automation/autofill.mjs"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "playwright": "1.51.1"
  }
}
