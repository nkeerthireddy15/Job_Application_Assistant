PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/applypilot
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5050/api

# Optional: Gemini improves semantic job scoring and application-answer generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Serper enables search-based discovery across LinkedIn, Indeed, Naukri,
# Wellfound, Cutshort, Instahyre, Hirist, YC startup jobs and company career pages without automating logins.
SERPER_API_KEY=

# Daily collector. Server checks once per minute and runs once per local day.
DAILY_DISCOVERY_ENABLED=true
DAILY_DISCOVERY_HOUR=7
DAILY_DISCOVERY_MINUTE=0
DISCOVERY_MIN_SCORE=55
DISCOVERY_MAX_JOBS=500
